{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ftp-toolbox",
  "version": "0.2.0",
  "identifier": "com.workbuddy.ftptoolbox",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FTP/TFTP 工具箱",
        "width": 1024,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "WorkBuddy",
    "shortDescription": "FTP/TFTP 服务器与客户端一体工具",
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
