{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ftp-toolbox",
  "version": "0.3.1",
  "identifier": "com.workbuddy.ftptoolbox",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "FTP/TFTP 工具箱",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "publisher": "halacrcrc",
    "shortDescription": "FTP/TFTP 服务器与客户端一体工具",
    "windows": {
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      }
    }
  }
}
